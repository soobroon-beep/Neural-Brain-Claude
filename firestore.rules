rules_version = '2';

// NEURAL BRAIN — cada persona solo ve y cambia lo suyo.
//  users/{uid}/brains/{bid}            tus cerebros (nombre, color, fuentes, instrucciones, lo aprendido)
//  users/{uid}/brains/{bid}/{sub}/{id}  lo que les enseñas (notes), conversaciones (chatHistory), imágenes
//  users/{uid}/events/{id}             recuerdos que llegan de Nova Hub y VORTEX: los escribe SOLO el conector
//                                      (servidor); tú puedes leerlos y borrar alguno para que el cerebro lo olvide
//  users/{uid}/settings/{id}           conexiones (qué apps alimentan tu cerebro) y estado del conector
//  users/{uid}/sync/{app}              memoria interna del conector: cerrada a la app
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if owner(uid);

      match /brains/{bid} {
        allow read, write: if owner(uid);
        match /{sub}/{id} {
          allow read, write: if owner(uid);
        }
      }
      match /events/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if false;
      }
      match /settings/{id} {
        allow read: if owner(uid);
        allow write: if owner(uid) && id == 'connections';
      }
      match /sync/{app} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
